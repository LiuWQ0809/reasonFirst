# Full base URL of your self-managed GitLab instance.
# HTTP works for the MCP -> GitLab hop if you intentionally use HTTP on a trusted network.
GITLAB_BASE_URL=http://gitlab.example.internal

# Dedicated read-only token. Never commit the real token.
# Recommended scopes for this server: read_api + read_repository
GITLAB_TOKEN=glpat_REPLACE_ME

# Optional exact comma-separated numeric project IDs and/or path_with_namespace values.
# Leave empty to expose every project readable by the token.
# Example: GITLAB_ALLOWED_PROJECTS=42,team/project-a,team/project-b
GITLAB_ALLOWED_PROJECTS=

# Keep true for normal HTTPS certificates. Only disable for controlled test environments.
GITLAB_VERIFY_SSL=true

# Ignore HTTP_PROXY/HTTPS_PROXY/ALL_PROXY by default. This is useful when an internal
# GitLab should be reached directly even though the host machine uses a SOCKS/VPN proxy.
GITLAB_TRUST_ENV=false

GITLAB_TIMEOUT_SECONDS=30
GITLAB_MAX_TEXT_BYTES=120000
LOG_LEVEL=INFO
