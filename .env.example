# GitLab API: use your own canonical HTTPS endpoint. Never put tokens in URLs.
# This is a configuration template, not a working deployment.
GITLAB_BASE_URL=https://gitlab.example.com

# Keep this API identity read-only. Recommended: read_api + read_repository.
# Enter the real value only in your private user configuration, never here.
GITLAB_TOKEN=REPLACE_ME

# Exact comma-separated project paths (path_with_namespace).
# Workspace creation requires a nonempty allowlist by default.
# This is the local MCP project grant, NOT a setting in the OpenAI tunnel profile.
# For a new project: confirm existence/path and GitLab access, then have the user
# explicitly append its exact identifier here in their PRIVATE effective config.
# Preserve existing entries; never clear the list to bypass a denial. Empty means
# all token-accessible projects for MCP reads (write policy remains separate).
# Restart the existing MCP process after a deliberate grant; exported values win.
# First call check_project_access or actual-coder-check-project; stop on ok=false.
# See docs/PROJECT_ACCESS.md and docs/PROJECT_ACCESS_CN.md. No automatic grants.
GITLAB_ALLOWED_PROJECTS=team/project-a
# API/MCP clients reject disabled verification and all API redirects.
GITLAB_VERIFY_SSL=true
# Optional additional PEM CA certificates for Python API/MCP only, not native Git
# or the maintenance --check-tls probe. Use an absolute path or ~/; never a key.
# GITLAB_CA_BUNDLE=/absolute/path/company-ca.pem
GITLAB_TRUST_ENV=false
GITLAB_TIMEOUT_SECONDS=30
GITLAB_MAX_TEXT_BYTES=120000
LOG_LEVEL=INFO

# Optional separate Git HTTPS credential. read_repository is enough for reads;
# write_repository is needed to push. Empty falls back to GITLAB_TOKEN, without
# adding permissions. Do not grant broad API rights merely to enable Git push.
# Optional explicit Git HTTPS credential for approved self-managed setups.
GITLAB_GIT_PASSWORD=
GITLAB_GIT_TOKEN=
GITLAB_GIT_USERNAME=oauth2

# Direct network access by default. Set true only for an intentional proxy setup.
# This is independent of TLS trust; it is not a private-CA configuration switch.
GITLAB_GIT_TRUST_ENV=false
GITLAB_REQUIRE_WRITE_ALLOWLIST=true

# Outside the source repository: managed caches, state and worktrees.
# HTTPS migration backups here can contain credentials and must remain private.
GITLAB_WORKSPACE_ROOT=~/.local/share/chatgpt-gitlab-mcp
GITLAB_BRANCH_PREFIX=chatgpt/
GITLAB_DEFAULT_BASE_REF=main

# Approved build/test entry points, not a sandbox: each may run repository code.
# Review and narrow this list for your own projects.
GITLAB_ALLOWED_EXECUTABLES=python,python3,pytest,uv,node,npm,pnpm,yarn,make,cmake,ninja,cargo,go,mvn,gradle
GITLAB_COMMAND_TIMEOUT_SECONDS=300
GITLAB_COMMAND_MAX_OUTPUT_BYTES=120000
GITLAB_MAX_WRITE_FILE_BYTES=1000000

# Optional author identity; otherwise Git uses your existing configuration.
# GITLAB_GIT_AUTHOR_NAME=Your Name
# GITLAB_GIT_AUTHOR_EMAIL=you@example.com

# Existing exported values take precedence over this file. Select the effective
# private file with GITLAB_AGENT_ENV_FILE. Do not overwrite an existing user .env
# during an upgrade; use docs/HTTPS_MIGRATION.md for an existing HTTP setup.
# API and Git have separate trust settings. GITLAB_CA_BUNDLE is Python-only;
# SSL_CERT_FILE/SSL_CERT_DIR do not implicitly choose Python API/MCP trust.
# See docs/HTTPS_API_TLS.md; never disable verification to fix a CA error.
